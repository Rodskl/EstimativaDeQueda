{
  "expo": {
    "name": "FallGuard",
    "slug": "fallguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Permitir que o FallGuard acesse os sensores de movimento deste dispositivo para monitoramento contínuo de quedas."
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.trabalho.fallguard",
      "permissions": [
        "VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.trabalho.fallguard"
    },
    "sdkVersion": "54.0.0"
  }
}